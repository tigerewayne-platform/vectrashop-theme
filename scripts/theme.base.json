{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": { "contentSize": "760px", "wideSize": "1280px" },
    "color": { "defaultPalette": false, "defaultGradients": false, "custom": false, "customGradient": false, "defaultDuotone": false },
    "typography": {
      "defaultFontSizes": false,
      "fluid": true,
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.8125rem", "fluid": false },
        { "slug": "body", "name": "Body", "size": "0.9375rem", "fluid": false },
        { "slug": "price", "name": "Price", "size": "1.125rem", "fluid": false },
        { "slug": "h2", "name": "Heading 2", "size": "1.375rem", "fluid": { "min": "1.25rem", "max": "1.375rem" } },
        { "slug": "h1", "name": "Heading 1", "size": "1.875rem", "fluid": { "min": "1.5rem", "max": "1.875rem" } },
        { "slug": "hero", "name": "Hero", "size": "2.5rem", "fluid": { "min": "1.875rem", "max": "2.5rem" } }
      ]
    },
    "spacing": { "defaultSpacingSizes": false, "units": ["px", "rem", "%", "vw"] }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--bench)", "text": "var(--wp--preset--color--graphite)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--sans)", "fontSize": "var(--wp--preset--font-size--body)", "fontWeight": "400", "lineHeight": "1.6" },
    "spacing": {
      "padding": { "left": "max(16px, 3vw)", "right": "max(16px, 3vw)" },
      "blockGap": "var(--wp--preset--spacing--space-5)"
    },
    "elements": {
      "heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "700", "lineHeight": "1.2", "letterSpacing": "-0.02em" } },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--h1)" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--h2)" } },
      "h3": { "typography": { "fontSize": "1.125rem" } },
      "link": {
        "color": { "text": "var(--wp--preset--color--copper-text)" },
        "typography": { "textDecoration": "underline" },
        ":hover": { "typography": { "textDecoration": "none" } }
      },
      "button": {
        "color": { "background": "var(--wp--preset--color--copper)", "text": "var(--wp--preset--color--copper-ink)" },
        "border": { "radius": "999px" },
        "spacing": { "padding": { "top": "0.7rem", "bottom": "0.7rem", "left": "1.25rem", "right": "1.25rem" } },
        "typography": { "fontWeight": "700", "fontSize": "0.875rem" },
        ":hover": { "color": { "background": "var(--wp--preset--color--graphite)", "text": "var(--wp--preset--color--frame-ink)" } },
        ":focus": { "outline": { "color": "var(--wp--preset--color--copper)", "offset": "2px", "style": "solid", "width": "2px" } }
      }
    },
    "blocks": {
      "core/search": { "border": { "radius": "999px" } },
      "core/separator": { "color": { "text": "var(--wp--preset--color--hairline)" } },
      "woocommerce/product-price": { "typography": { "fontSize": "var(--wp--preset--font-size--price)", "fontWeight": "800" } },
      "core/post-title": { "typography": { "fontWeight": "700" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
